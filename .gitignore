# Secrets. Never committed, never read aloud, never echoed.
.env
.env.*
!.env.example

# Keys and credentials. The policy protects .pem/.key by clause; git protects
# them here too, because a clause cannot stop a file that is already committed.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
*.crt
credentials.json
secrets.json

node_modules/
*.log

# OS junk.
.DS_Store
Thumbs.db
desktop.ini
._*

# NOTE: policy-compiled.json is deliberately NOT ignored. The cached compile
# is the artifact the server replays by default; it ships with the repo so a
# fresh clone enforces immediately without an API key. Regenerating it is
# `npm run policy:fresh`, behind that explicit command only.

# Adversarial M4 fixture: a file-deleting MCP server used to test hook coverage.
# Not product code; never shipped.
attack-fixtures/

# Reviewed-but-not-accepted draft. Transient; the hook never reads it.
policy-compiled.pending.json

# Compiled output for the npm package. Built by prepack; never committed.
dist/
*.tgz

# npm auth. The token lives in the USER-level ~/.npmrc only — never here.
.npmrc
